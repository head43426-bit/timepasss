# Kill Chain Attack Path Reconstruction — FULL version
# Copy this file to .env in a PRIVATE server build only. NEVER commit .env.
# This browser build does NOT read this file and does NOT call any live API.
# All enrichment here is mock fallback until a server build replaces it.

# Future MITRE / technique enrichment (server build only)
MITRE_API_KEY=YOUR_MITRE_API_KEY_HERE
MITRE_API_URL=https://example-mitre-endpoint.invalid

# Future threat-intel enrichment (server build only)
THREAT_INTEL_API_KEY=YOUR_THREAT_INTEL_API_KEY_HERE
THREAT_INTEL_API_URL=https://example-threat-intel-endpoint.invalid

# Future SIEM ingestion (server build only — never a browser key)
SIEM_API_KEY=YOUR_SIEM_API_KEY_HERE
SIEM_BASE_URL=https://example-siem-endpoint.invalid

# Mode: mock (default, safe) | key-configured (server build only)
ENRICHMENT_MODE=mock

# Python engine: report translation via Sarvam API (server only).
# HOW TO USE IT: copy this file to a file named exactly `.env` in the
# REPO ROOT (same folder as main.py, NOT frontend/), put your real key
# on the SARVAM_API_KEY line below, then RESTART the server (a page
# reload alone does not load it). The dashboard's Report language
# dropdown (English, Hindi, Tamil, Telugu, Malayalam) uses it.
# Placeholder only -- no real key. Without a key, Hindi reports are a
# clearly labelled mock template, never a claimed Sarvam translation.
SARVAM_API_KEY=
